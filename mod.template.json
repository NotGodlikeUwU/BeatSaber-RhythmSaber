  "dependencies": [
    { "id": "beatsaber-hook", "version": "^6.4.2", "downloadIfMissing": "https://github.com/QuestPackageManager/beatsaber-hook/releases/download/v6.4.2/beatsaber-hook.qmod" },
    { "id": "custom-types", "version": "^0.18.4", "downloadIfMissing": "https://github.com/QuestPackageManager/Il2CppQuestTypePatching/releases/download/v0.18.4/CustomTypes.qmod" },
    { "id": "paper2_scotland2", "version": "^4.8.0", "downloadIfMissing": "https://github.com/Fernthedev/paperlog/releases/download/v4.8.0/paper2_scotland2.qmod" },
    { "id": "bsml", "version": "^0.4.55", "downloadIfMissing": "https://github.com/bsq-ports/Quest-BSML/releases/download/v0.4.55/BSML.qmod" },
    { "id": "metacore", "version": "^1.6.3", "downloadIfMissing": "https://github.com/Metalit/MetaCore/releases/download/v1.6.3/MetaCore.qmod" }
  ],
  "modFiles": [], "lateModFiles": ["${binary}"],
  "libraryFiles": [], "fileCopies": []
